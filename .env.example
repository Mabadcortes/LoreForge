# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=loreforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loreforge
# "localhost" when running the backend directly on the host machine.
# docker-compose will override it with the service name "db" (phase 0, step 5).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
