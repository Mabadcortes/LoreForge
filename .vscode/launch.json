{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": [
        "app.main:create_app",
        "--factory",
        "--reload",
        "--port",
        "8000",
        "--loop",
        "asyncio:SelectorEventLoop"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
